# Copy to backend/.env and fill in. Never commit backend/.env.

# Optional: stable key used to encrypt the stored GitHub token (auto-generated into data/secret.key otherwise)
SECRET_KEY=

# Supabase (durable database through its HTTPS API). Leave both empty to use a local SQLite file only.
# Run supabase/schema.sql once in the Supabase SQL Editor first.
SUPABASE_URL=
# Secret key (sb_secret_...) from Supabase > Project Settings > API Keys. NOT the publishable key.
SUPABASE_SECRET_KEY=

# Local development without Google: set to 1 (never in production)
DEV_LOGIN=

# Continue with Google. Redirect URI: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# GitHub OAuth App. Authorization callback URL must be:  {BACKEND_URL}/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional developer fallback instead of OAuth (token stays server-side; needs repo + workflow scopes)
GITHUB_TOKEN=

# Render: https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=
# Optional: workspace/owner id (defaults to the first owner the API returns)
RENDER_OWNER_ID=

# Vercel: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Netlify: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=

# Cloudflare: API token with the "Cloudflare Pages: Edit" permission
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
